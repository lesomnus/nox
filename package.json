{
  "name": "@lesomnus/nox",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "docs",
    "ORIGIN.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "nox-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "nox-source": "./src/theme/tokens.css",
      "default": "./dist/style.css"
    },
    "./terminal": {
      "nox-source": {
        "types": "./src/terminal/index.ts",
        "default": "./src/terminal/index.ts"
      },
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    },
    "./editor": {
      "nox-source": {
        "types": "./src/editor/index.ts",
        "default": "./src/editor/index.ts"
      },
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    }
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "dev": "node scripts/watch.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "storybook": "storybook dev -p 6008 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build",
    "prebuild-storybook": "npm run build",
    "example:source": "vite --config examples/consumer/vite.config.ts --mode source",
    "example:dist": "vite --config examples/consumer/vite.config.ts --mode dist",
    "example:build:source": "vite build --config examples/consumer/vite.config.ts --mode source",
    "example:build:dist": "vite build --config examples/consumer/vite.config.ts --mode dist",
    "format": "prettier --write src .storybook e2e scripts examples docs *.ts *.json README.md",
    "format:check": "prettier --check src .storybook e2e scripts examples docs *.ts *.json README.md",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "monaco-editor": "^0.55.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "description": "Reusable React components with CSS Modules, theme tokens and portable editor and terminal surfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesomnus/nox.git"
  },
  "homepage": "https://github.com/lesomnus/nox#readme",
  "bugs": {
    "url": "https://github.com/lesomnus/nox/issues"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "monaco-editor": "0.55.1"
  }
}
