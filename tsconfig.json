{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "customConditions": ["nox-source"],
    "types": ["vite/client", "node"]
  },
  "include": ["src", ".storybook", "e2e", "examples", "*.ts"]
}
